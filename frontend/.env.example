# Public Vercel-only build: no backend, no database, no login.
# Guest tests and catalog data come from committed JSON.
NEXT_PUBLIC_APP_MODE=static

# Full mode only: point the Next.js rewrite at the deployed FastAPI API.
# NEXT_PUBLIC_APP_MODE=full
# BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Public mascot assistant (server-side only; never use NEXT_PUBLIC_ here)
# GEMINI_API_KEY=your-google-ai-studio-key
# GEMINI_MODEL=gemini-3.1-flash-lite
# PUBLIC_ASSISTANT_RATE_LIMIT=20
# PUBLIC_ASSISTANT_DAILY_LIMIT=300
